cmake_minimum_required(VERSION 3.20)

# Nav-generated board context. Generated by `nav build` from share/nav/boards/.
# Must be included BEFORE project() so toolchain settings (CMAKE_C_COMPILER
# etc.) derived from it take effect for CMake's compiler-detection probe.
if(EXISTS "${CMAKE_BINARY_DIR}/nav-board.cmake")
    include("${CMAKE_BINARY_DIR}/nav-board.cmake")
endif()

set(CMAKE_SYSTEM_NAME Generic)
if(NAV_BOARD_ARCH)
    set(CMAKE_SYSTEM_PROCESSOR ${NAV_BOARD_ARCH})
endif()

if(NAV_BOARD_COMPILER)
    set(CMAKE_C_COMPILER   ${NAV_BOARD_COMPILER})
    set(CMAKE_ASM_COMPILER ${NAV_BOARD_COMPILER})
    string(REGEX REPLACE "gcc$" "" NAV_TOOLCHAIN_PREFIX "${NAV_BOARD_COMPILER}")
    set(CMAKE_OBJCOPY     ${NAV_TOOLCHAIN_PREFIX}objcopy)
    set(CMAKE_BINARY_SIZE ${NAV_TOOLCHAIN_PREFIX}size)
endif()

# Nav-resolved registry dependencies (libraries + toolchain) from nav.lock.
# Included before project() so a registry-provided compiler takes effect for
# CMake's compiler-detection probe.
if(EXISTS "${CMAKE_BINARY_DIR}/nav-deps.cmake")
    include("${CMAKE_BINARY_DIR}/nav-deps.cmake")
endif()

# A registry toolchain (e.g. `nav add arm-none-eabi-gcc`) overrides the board's
# bare compiler name with a concrete cached path.
if(NAV_DEPS_COMPILER)
    set(CMAKE_C_COMPILER   ${NAV_DEPS_COMPILER})
    set(CMAKE_ASM_COMPILER ${NAV_DEPS_COMPILER})
    string(REGEX REPLACE "gcc$" "" NAV_TOOLCHAIN_PREFIX "${NAV_DEPS_COMPILER}")
    set(CMAKE_OBJCOPY     ${NAV_TOOLCHAIN_PREFIX}objcopy)
    set(CMAKE_BINARY_SIZE ${NAV_TOOLCHAIN_PREFIX}size)
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

project({{PROJECT_NAME}} C CXX ASM)

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# 1. Sync global configuration to dependency path
#    A build variant may name another .config (nav passes -DNAV_APP_CONFIG=...).
set(NAV_APP_CONFIG_FILE "${CMAKE_CURRENT_SOURCE_DIR}/.config")
if(NAV_APP_CONFIG)
    set(NAV_APP_CONFIG_FILE "${NAV_APP_CONFIG}")
endif()
if(EXISTS "${NAV_APP_CONFIG_FILE}")
    message(STATUS "[Nav] Locking active configuration context...")
    configure_file(
        "${NAV_APP_CONFIG_FILE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/extern/NavHAL/.config"
        COPYONLY
    )
else()
    message(WARNING "[Nav] Master '.config' not detected in project root! Utilizing ambient internal repository defaults.")
endif()

# 1b. Pre-NavHAL dependency hooks. A vector-owning library (e.g. the vaios RTOS)
#     needs NavHAL built with -DSUBMODULE so it cedes the SysTick/PendSV/SVCall/
#     HardFault handlers. nav emits this when such a dependency is present; it
#     MUST run before NavHAL is added.
#     nav-deps-pre.cmake only names the define (NAV_NAVHAL_DEFINES); it is applied
#     to the NavHAL targets alone below, so it does not leak into the app or into
#     other libraries. NAV_TEMPLATE_SCOPED_DEFINES tells the pre file this
#     template does that.
set(NAV_TEMPLATE_SCOPED_DEFINES ON)
set(NAV_NAVHAL_DEFINES)
if(EXISTS "${CMAKE_BINARY_DIR}/nav-deps-pre.cmake")
    include("${CMAKE_BINARY_DIR}/nav-deps-pre.cmake")
endif()

# Every target created in a directory and its subdirectories (NavHAL builds its
# libraries in nested directories, so the top directory holds none of them).
function(nav_directory_targets dir out)
    set(_found)
    set(_todo "${dir}")
    while(_todo)
        list(POP_FRONT _todo _d)
        get_property(_t DIRECTORY "${_d}" PROPERTY BUILDSYSTEM_TARGETS)
        list(APPEND _found ${_t})
        get_property(_sub DIRECTORY "${_d}" PROPERTY SUBDIRECTORIES)
        list(APPEND _todo ${_sub})
    endwhile()
    set(${out} ${_found} PARENT_SCOPE)
endfunction()

# 2. Add NavHAL Dependency Framework
add_subdirectory(extern/NavHAL)
if(NAV_NAVHAL_DEFINES)
    nav_directory_targets(extern/NavHAL _nav_hal_targets)
    foreach(_nav_t ${_nav_hal_targets})
        get_target_property(_nav_type ${_nav_t} TYPE)
        if(NOT _nav_type STREQUAL "INTERFACE_LIBRARY" AND NOT _nav_type STREQUAL "UTILITY")
            target_compile_definitions(${_nav_t} PRIVATE ${NAV_NAVHAL_DEFINES})
        endif()
    endforeach()
endif()

# 2a. Nav library dependencies (from nav.toml [dependencies]). nav resolves the
#     transitive graph and writes build/nav-deps-libs.cmake, which
#     add_subdirectory()s each library and wires their link edges. Libraries
#     compile their NavHAL-dependent sources against this include path.
set(NAV_NAVHAL_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/extern/NavHAL/include")
if(EXISTS "${CMAKE_BINARY_DIR}/nav-deps-libs.cmake")
    include("${CMAKE_BINARY_DIR}/nav-deps-libs.cmake")
endif()

# 3. Inherit Dynamic Target Environment Variables (NavHAL exports BOARD,
#    FLASHER, FLASH_ADDRESS for backward compatibility with its config flow).
include("${CMAKE_BINARY_DIR}/config.cmake")

# 4. Declare user application target. The app's sources, include dirs, defines
#    and flags come from nav.toml [build]: `nav build` expands the globs into
#    build/nav-app.cmake, so this file carries nothing app-specific. Without that
#    file (or without [build] keys) the app is src/main.c + include/.
set(NAV_APP_SOURCES src/main.c)
set(NAV_APP_INCLUDE_DIRS include)
set(NAV_APP_DEFINES)
set(NAV_APP_C_FLAGS)
set(NAV_APP_C_STANDARD)
set(NAV_APP_LINKER_FRAGMENT)
set(NAV_APP_LIBC none)
set(NAV_APP_OUTPUT)
set(NAV_APP_LIBS)
set(NAV_APP_SYSCALLS nosys)
set(NAV_APP_DEPS_OPT)
if(EXISTS "${CMAKE_BINARY_DIR}/nav-app.cmake")
    include("${CMAKE_BINARY_DIR}/nav-app.cmake")
endif()
# [build] deps_opt: one -O level for NavHAL and every dependency library. It is a
# per-target option, which CMake puts after CMAKE_C_FLAGS(_<CONFIG>) and the
# directory options and after whatever the target itself added at configure
# time, so it is the last -O on the compile line and wins.
if(NAV_APP_DEPS_OPT)
    nav_directory_targets(extern/NavHAL _nav_hal_targets)
    foreach(_nav_t ${_nav_hal_targets} ${NAV_ALL_DEP_TARGETS})
        if(TARGET ${_nav_t})
            get_target_property(_nav_type ${_nav_t} TYPE)
            get_target_property(_nav_imported ${_nav_t} IMPORTED)
            if(NOT _nav_imported AND NOT _nav_type STREQUAL "INTERFACE_LIBRARY" AND NOT _nav_type STREQUAL "UTILITY")
                target_compile_options(${_nav_t} PRIVATE "-${NAV_APP_DEPS_OPT}")
            endif()
        endif()
    endforeach()
endif()
add_executable(${PROJECT_NAME} ${NAV_APP_SOURCES})
# A build variant may rename the firmware file (nav.toml [variant.*] output).
set(NAV_APP_FILE_NAME "${PROJECT_NAME}")
if(NAV_APP_OUTPUT)
    set(NAV_APP_FILE_NAME "${NAV_APP_OUTPUT}")
    set_target_properties(${PROJECT_NAME} PROPERTIES OUTPUT_NAME "${NAV_APP_OUTPUT}")
endif()
if(NAV_APP_DEFINES)
    target_compile_definitions(${PROJECT_NAME} PRIVATE ${NAV_APP_DEFINES})
endif()
if(NAV_APP_C_FLAGS)
    target_compile_options(${PROJECT_NAME} PRIVATE
        "$<$<COMPILE_LANGUAGE:C>:${NAV_APP_C_FLAGS}>")
endif()
if(NAV_APP_C_STANDARD)
    set_target_properties(${PROJECT_NAME} PROPERTIES
        C_STANDARD ${NAV_APP_C_STANDARD} C_STANDARD_REQUIRED ON)
endif()

# 4a. App-level Kconfig hook. Only present when the app ships a root Kconfig:
#     nav writes build/nav-app-kconfig.cmake (CONFIG_* CMake variables and
#     NAV_APP_AUTOCONF) and force-includes app_autoconf.h into the app's sources.
if(EXISTS "${CMAKE_BINARY_DIR}/nav-app-kconfig.cmake")
    include("${CMAKE_BINARY_DIR}/nav-app-kconfig.cmake")
    target_compile_options(${PROJECT_NAME} PRIVATE "SHELL:-include ${NAV_APP_AUTOCONF}")
endif()

# 5. Apply board-derived compilation flags.
if(NAV_BOARD_COMPILE_FLAGS)
    target_compile_options(${PROJECT_NAME} PRIVATE ${NAV_BOARD_COMPILE_FLAGS})
endif()

# 6. Hardware-Bound Linker Directives.
#
# The board's linker script comes from NavHAL by name where NavHAL offers it.
# NavHAL publishes NAVHAL_LINKER_SCRIPT and carries the -L its INCLUDE needs on
# the `hal` target, so which file describes this board's memory stays NavHAL's
# business -- naming the path here made every generated project depend on
# NavHAL's directory layout. The path is kept only as a fallback for older
# NavHAL, and should go when the resolved ref always exports the variable.
if(NAVHAL_LINKER_SCRIPT)
    set(NAV_LINKER_SCRIPT "${NAVHAL_LINKER_SCRIPT}")
else()
    # Deprecated fallback for a NavHAL that predates the export: name the path,
    # the way this template used to. Kept only so a project built against an
    # older NavHAL still links -- delete it once the NavHAL ref nav resolves
    # publishes the variable, since the whole point is not knowing this layout.
    set(NAV_LINKER_SCRIPT
        "${CMAKE_CURRENT_SOURCE_DIR}/extern/NavHAL/src/board/${BOARD}/linker.ld")
    if(NOT EXISTS "${NAV_LINKER_SCRIPT}")
        # Failing here beats passing no -T at all: ld would quietly fall back to
        # its own default script and produce an image that does not boot.
        message(FATAL_ERROR
            "No linker script: extern/NavHAL exports no NAVHAL_LINKER_SCRIPT and "
            "${NAV_LINKER_SCRIPT} does not exist. Update NavHAL.")
    endif()
endif()
# [build] linker_fragment: an app script layered on the board script (it should
# use INSERT AFTER ...;); NavHAL's script stays the base. GNU ld only resolves
# an INSERT target when the fragment's -T comes BEFORE the board's -T on its
# command line ("board then app" fails with ".text not found for insert").
# SHELL: keeps CMake from de-duplicating the repeated -T.
set(NAV_APP_LINK_OPTIONS)
if(NAV_APP_LINKER_FRAGMENT)
    list(APPEND NAV_APP_LINK_OPTIONS "SHELL:-T \"${NAV_APP_LINKER_FRAGMENT}\"")
    set_property(TARGET ${PROJECT_NAME} APPEND PROPERTY LINK_DEPENDS "${NAV_APP_LINKER_FRAGMENT}")
endif()
list(APPEND NAV_APP_LINK_OPTIONS "SHELL:-T \"${NAV_LINKER_SCRIPT}\"")
# [build] libc: "none" is freestanding (-nostdlib); "newlib" drops it and links
# the C library. The system libraries are collected here and emitted LAST on the
# link line (step 7), after the app, hal and every dependency archive, so a
# dependency's own _sbrk/_write/... beat the library's stubs. [build] syscalls =
# "none" leaves out -lnosys altogether.
set(NAV_APP_SYS_LIBS)
if(NAV_APP_LIBC STREQUAL "newlib")
    list(APPEND NAV_APP_SYS_LIBS -lc -lm)
else()
    list(APPEND NAV_APP_LINK_OPTIONS "-nostdlib")
endif()
foreach(_nav_lib ${NAV_APP_LIBS})
    list(APPEND NAV_APP_SYS_LIBS "-l${_nav_lib}")
endforeach()
if(NAV_APP_LIBC STREQUAL "newlib" AND NOT NAV_APP_SYSCALLS STREQUAL "none")
    list(APPEND NAV_APP_SYS_LIBS -lnosys)
endif()
list(APPEND NAV_APP_SYS_LIBS -lgcc)
# nosys.specs makes gcc itself append -lnosys, so syscalls = "none" must drop it.
set(NAV_APP_SPECS "--specs=nosys.specs")
if(NAV_APP_LIBC STREQUAL "newlib" AND NAV_APP_SYSCALLS STREQUAL "none")
    set(NAV_APP_SPECS)
endif()
target_link_options(${PROJECT_NAME} PRIVATE
  ${NAV_APP_LINK_OPTIONS}
  ${NAV_APP_SPECS}
  ${NAV_BOARD_LINK_FLAGS}
)

# 8. Bind includes. The app's own directories are ordinary includes; NavHAL and
#    everything that arrives through a dependency are SYSTEM, so a warning in a
#    vendor header never trips the app's -Werror.
target_include_directories(${PROJECT_NAME} PUBLIC ${NAV_APP_INCLUDE_DIRS})
target_include_directories(${PROJECT_NAME} SYSTEM PUBLIC extern/NavHAL/include)

# Mark the include dirs a dependency (and hal) exports as SYSTEM for whoever
# links it. Done with INTERFACE_SYSTEM_INCLUDE_DIRECTORIES rather than the
# SYSTEM target property (CMake 3.25+) because this template supports 3.20.
# Only the consumer sees the change; the library still builds with its own
# warnings. Walks the link graph, so a dependency's own dependencies count too.
set(_nav_todo hal ${NAV_DEP_TARGETS})
set(_nav_seen)
while(_nav_todo)
    list(POP_FRONT _nav_todo _nav_t)
    if(NOT TARGET ${_nav_t} OR "${_nav_t}" IN_LIST _nav_seen)
        continue()
    endif()
    list(APPEND _nav_seen ${_nav_t})
    get_target_property(_nav_imported ${_nav_t} IMPORTED)
    if(NOT _nav_imported)
        set_property(TARGET ${_nav_t} APPEND PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
            "$<TARGET_PROPERTY:${_nav_t},INTERFACE_INCLUDE_DIRECTORIES>")
    endif()
    get_target_property(_nav_links ${_nav_t} INTERFACE_LINK_LIBRARIES)
    if(_nav_links)
        list(APPEND _nav_todo ${_nav_links})
    endif()
endwhile()

# 8a. Registry library inputs (from nav-deps.cmake): headers, archive search
#     dirs, and the resolved static archives themselves.
if(NAV_DEPS_INCLUDE_DIRS)
    target_include_directories(${PROJECT_NAME} SYSTEM PUBLIC ${NAV_DEPS_INCLUDE_DIRS})
endif()
if(NAV_DEPS_LINK_DIRS)
    target_link_directories(${PROJECT_NAME} PRIVATE ${NAV_DEPS_LINK_DIRS})
endif()
# 7. Link line. The app's objects come first, then one group holding hal (Whole
#    Archive mandatory for static HAL exports), the resolved registry archives
#    and every nav library dependency, then the system libraries in their own
#    group. Keeping the system libraries last is what makes a dependency's
#    syscalls win over newlib's / nosys' stubs.
target_link_libraries(${PROJECT_NAME} PRIVATE
  -Wl,--start-group
    -Wl,--whole-archive hal -Wl,--no-whole-archive
    ${NAV_DEPS_LIBRARIES}
    ${NAV_DEP_TARGETS}
  -Wl,--end-group
  -Wl,--start-group
    ${NAV_APP_SYS_LIBS}
  -Wl,--end-group
)

# 8c. Print the image size after every link.
if(CMAKE_BINARY_SIZE)
    add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
        COMMAND ${CMAKE_BINARY_SIZE} $<TARGET_FILE:${PROJECT_NAME}>
        COMMENT "Image size:"
        VERBATIM)
endif()

# 9. Flash target support. Prefer Nav-resolved flasher; fall back to NavHAL's
#    BOARD-derived FLASHER / FLASH_ADDRESS when the catalog leaves them blank.
set(NAV_RESOLVED_FLASHER "${FLASHER}")
set(NAV_RESOLVED_FLASH_ADDRESS "${FLASH_ADDRESS}")
if(NAV_BOARD_FLASH_TOOL)
    set(NAV_RESOLVED_FLASHER "${NAV_BOARD_FLASH_TOOL}")
endif()
if(NAV_BOARD_FLASH_ADDRESS)
    set(NAV_RESOLVED_FLASH_ADDRESS "${NAV_BOARD_FLASH_ADDRESS}")
endif()
if(NAV_RESOLVED_FLASHER AND NAV_RESOLVED_FLASH_ADDRESS)
    add_custom_target(flash
      COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:${PROJECT_NAME}> ${CMAKE_CURRENT_BINARY_DIR}/${NAV_APP_FILE_NAME}.bin
      COMMAND ${NAV_RESOLVED_FLASHER} write ${CMAKE_CURRENT_BINARY_DIR}/${NAV_APP_FILE_NAME}.bin ${NAV_RESOLVED_FLASH_ADDRESS}
      DEPENDS ${PROJECT_NAME}
      COMMENT "Pumping Binary payload onto board..."
    )
endif()
