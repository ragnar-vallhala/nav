/**
 * @file main.c
 * @brief Autogenerated starter file for an AVR board. Ready to Fly with NavHAL!
 */

#include "board.h"
#include "navhal.h"

int main(void) {
    // 1. Bootstrap the HAL timebase (1 ms tick).
    hal_timebase_init(1000);

    // 2. Open the board console UART (USART0 on the ATmega328P).
    hal_uart_config_t uart_cfg = {.baudrate = 115200};
    hal_uart_init(BOARD_CONSOLE_UART, &uart_cfg);

    hal_uart_print(BOARD_CONSOLE_UART, "System Up.\r\n");

    while (1) {
        // Main logic loop
    }

    return 0;
}
