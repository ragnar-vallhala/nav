# Drivers a new nav project starts with. `nav create` and `nav board use` add
# these on top of the board's NavHAL defconfig; a board that lacks one of them
# ignores it.
CONFIG_USE_FPU=y
CONFIG_DRV_CLOCK=y
CONFIG_DRV_INTERRUPT=y
CONFIG_DRV_GPIO=y
CONFIG_DRV_TIMER=y
CONFIG_DRV_UART=y
CONFIG_DRV_DMA=y
CONFIG_DRV_CRC=y
CONFIG_DRV_DWT=y
CONFIG_DRV_FPU=y
CONFIG_DRV_I2C=y
CONFIG_DRV_SPI=y
CONFIG_DRV_PWM=y
CONFIG_DRV_SDIO=y
CONFIG_DRV_FLASH=y
CONFIG_SAMPLE_NONE=y
